# Configure production values in Sites environment settings, not in Git.
# Only the intended editor accounts belong in this server-side allowlist.
EDITOR_EMAILS=
# Optional public Formspree endpoints. These do not become active until configured.
PUBLIC_FORMSPREE_ENDPOINT=
PUBLIC_FORMSPREE_PARENT_ENDPOINT=
# Local preview uses .dev.vars with EDITOR_EMAILS=seedy@sites.test.
# Never commit .dev.vars or production credentials.
